    {
      "parameters": {
        "jsCode": "const rawItem = $input.first()?.json || {};\n\n// 1. Pull dynamic caption directly from Telegram Trigger as the source of truth\nconst telegramTrigger = $('Telegram Trigger').first()?.json || {};\nconst caption = telegramTrigger.message?.caption || rawItem.message?.caption || '';\n\n// Extract the first integer in caption (e.g. \"20 students\" -> 20)\nconst captionMatch = caption.match(/\\d+/);\nconst dynamicClaimedCount = captionMatch ? parseInt(captionMatch[0], 10) : null;\n\n// 2. Extract AI text output\nlet rawText = '';\nif (typeof rawItem.text === 'string') {\n  rawText = rawItem.text;\n} else if (typeof rawItem.response?.text === 'string') {\n  rawText = rawItem.response.text;\n} else if (rawItem.content?.parts?.[0]?.text) {\n  rawText = rawItem.content.parts[0].text;\n} else if (typeof rawItem.content === 'string') {\n  rawText = rawItem.content;\n} else if (rawItem.candidates?.[0]?.content?.parts?.[0]?.text) {\n  rawText = rawItem.candidates[0].content.parts[0].text;\n} else if (typeof rawItem === 'string') {\n  rawText = rawItem;\n}\n\nif (!rawText) {\n  throw new Error(\"No text found. Available keys in input: \" + JSON.stringify(Object.keys(rawItem)));\n}\n\n// Clean markdown wrappers\nlet clean = rawText.replace(/```json/gi, '').replace(/```/g, '').trim();\nconst start = clean.indexOf('{');\nconst end = clean.lastIndexOf('}');\nif (start !== -1 && end !== -1) {\n  clean = clean.substring(start, end + 1);\n}\n\n// 3. Parse AI JSON\nlet parsed = {};\ntry {\n  parsed = JSON.parse(clean);\n} catch (e) {\n  clean = clean.replace(/[\\n\\r]/g, ' ').replace(/\\\\n/g, ' ');\n  parsed = JSON.parse(clean);\n}\n\n// 4. Resolve claimed and observed counts without hardcoded fallbacks\nconst claimedHeadcount = dynamicClaimedCount !== null \n  ? dynamicClaimedCount \n  : Number(parsed.claim?.headcount ?? parsed.claimed_count ?? parsed.headcount_claimed ?? 0);\n\nconst observedHeadcount = Number(\n  parsed.observed?.headcount_estimate ?? \n  parsed.visible_count ?? \n  parsed.headcount_observed ?? \n  0\n);\n\n// 5. Evaluate discrepancy and status\nconst hasDiscrepancy = claimedHeadcount !== observedHeadcount;\nconst aiStatus = (parsed.audit?.status || (hasDiscrepancy ? 'FLAGGED' : 'PASSED')).toUpperCase();\n\n// Generate IST timestamp\nconst timestamp = new Intl.DateTimeFormat('en-CA', {\n  timeZone: 'Asia/Kolkata',\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit',\n  hour: '2-digit',\n  minute: '2-digit',\n  second: '2-digit',\n  hour12: false\n}).format(new Date()).replace(',', '');\n\nconst auditId = 'AUD-2026-' + Math.floor(100 + Math.random() * 900);\nconst tag = (parsed.program_tag || 'PROG-LITERACY').trim().toUpperCase();\n\nconst grantMap = {\n  'PROG-ROBOTICS': 'CSR-APEX-01',\n  'PROG-LITERACY': 'CSR-INDUS-02'\n};\n\nconst equipmentDetected = (\n  parsed.observed?.equipment_detected === true || \n  parsed.equipment_detected === true || \n  String(parsed.observed?.equipment_detected).toLowerCase() === 'true' ||\n  String(parsed.equipment_detected).toLowerCase() === 'true'\n) ? 'TRUE' : 'FALSE';\n\nreturn {\n  json: {\n    audit_id: auditId,\n    timestamp: timestamp,\n    program_tag: tag,\n    grant_id: grantMap[tag] || 'CSR-INDUS-02',\n    headcount_claimed: claimedHeadcount,\n    headcount_observed: observedHeadcount,\n    equipment_detected: equipmentDetected,\n    ai_status: aiStatus,\n    discrepancy_summary: parsed.audit?.discrepancy_summary || parsed.audit_reasoning || (hasDiscrepancy ? `Discrepancy detected: Claimed ${claimedHeadcount}, observed ${observedHeadcount}.` : 'Headcount verified successfully.'),\n    human_decision: 'PENDING',\n    reviewer_action_timestamp: ''\n  }\n};"
      },
