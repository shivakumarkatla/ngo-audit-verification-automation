    {
      "parameters": {
        "jsCode": "// Pull directly from the Trigger node to avoid being wiped by intermediate Telegram response nodes\nconst triggerData = $('Telegram Trigger').first()?.json || {};\nconst inputData = $input.first()?.json || {};\n\n// Check all possible paths where Telegram or n8n places the string\nconst callbackData = \n  triggerData.callback_query?.data ||\n  triggerData.body?.callback_query?.data ||\n  inputData.callback_query?.data ||\n  inputData.body?.callback_query?.data ||\n  '';\n\n// Trim and split by colon delimiter: ACTION:AUDIT_ID:GRANT_ID:TRAINER_CHAT_ID\nconst parts = callbackData.trim().split(':');\n\nconst rawAction = (parts[0] || '').trim().toUpperCase();\nconst auditId = (parts[1] || '').trim();\nconst grantId = (parts[2] || '').trim();\nconst trainerChatId = (parts[3] || '').trim();\n\nconst reviewer = \n  triggerData.callback_query?.from?.first_name || \n  triggerData.body?.callback_query?.from?.first_name || \n  'GrantOfficer';\n\n// Formatted strictly in Indian Standard Time (IST / Asia/Kolkata)\nconst istTimestamp = new Intl.DateTimeFormat('en-CA', {\n  timeZone: 'Asia/Kolkata',\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit',\n  hour: '2-digit',\n  minute: '2-digit',\n  second: '2-digit',\n  hour12: false\n}).format(new Date()).replace(',', '');\n\nconst statusMap = {\n  'APPROVE': 'APPROVED',\n  'OVERRIDE': 'OVERRIDDEN_APPROVED',\n  'REJECT': 'REJECTED',\n  'HOLD': 'HELD_FOR_AUDIT'\n};\n\nconst decisionStatus = statusMap[rawAction] || 'UNKNOWN_ACTION';\nconst isApproved = (rawAction === 'APPROVE' || rawAction === 'OVERRIDE');\n\nconst tranches = {\n  'CSR-APEX-01': 25000,\n  'CSR-INDUS-02': 12000\n};\n\nreturn {\n  json: {\n    raw_received_data: callbackData,\n    action: rawAction,\n    decision_status: decisionStatus,\n    audit_id: auditId,\n    grant_id: grantId,\n    trainer_chat_id: trainerChatId,\n    reviewer_name: reviewer,\n    timestamp: istTimestamp,\n    approval_timestamp: istTimestamp,\n    is_approved: isApproved,\n    disbursement_amount: isApproved ? (tranches[grantId] || 10000) : 0,\n    txn_id: isApproved ? ('TXN-' + Math.floor(100000 + Math.random() * 900000)) : ''\n  }\n};"
      },
